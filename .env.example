# Game server
PORT=8080

# memory keeps all runtime state in process. postgres persists accounts,
# sessions, wallets, rooms and chip transactions.
STORAGE_BACKEND=memory
DATABASE_URL=
# Keep false in production and run cmd/migrate before starting the server.
DATABASE_AUTO_MIGRATE=false
# Comma-separated exact Web origins used by deployed Flutter Web clients.
ALLOWED_ORIGINS=
# Short-lived access tokens are rotated by the client with the refresh token.
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000

# On SIGTERM the server stops starting new hands and waits up to this long for
# every table to finish its current hand before exiting. 0 exits immediately.
# Pair it with `docker stop -t <seconds+30>` so Docker does not SIGKILL first.
SHUTDOWN_DRAIN_TIMEOUT_SECONDS=120

# Tencent Cloud TRTC
# Copy this file to .env locally. Never commit the real secret key.
TRTC_SDK_APP_ID=
TRTC_SECRET_KEY=
TRTC_USER_SIG_EXPIRE_SECONDS=3600

# Required when requesting debug credentials from another device.
TRTC_DEBUG_TOKEN=

# Reverse proxy addresses (IP or CIDR, comma-separated) whose X-Forwarded-For
# may be trusted for the real client IP. Leave empty when the service is
# reached directly. A typical single-host nginx setup uses 127.0.0.1 or the
# Docker bridge gateway, for example 172.17.0.1.
TRUSTED_PROXIES=

# Enables GET /metrics (Prometheus text format) behind a Bearer token.
# Leave empty to disable the endpoint entirely. Minimum 16 characters.
METRICS_TOKEN=

# Rate limits as "count/duration" (Go duration syntax), or "off" to disable.
# Defaults are tuned for a friends-only table and rarely need changes.
RATE_LIMIT_AUTH_PER_IP=30/5m
RATE_LIMIT_REGISTER_PER_IP=5/1h
RATE_LIMIT_LOGIN_FAILURES_PER_USER=8/15m
RATE_LIMIT_USER_OPS_PER_USER=30/1m
RATE_LIMIT_TRTC_PER_USER=12/1m
# Maximum simultaneous WebSocket connections from one client IP, or "off".
RATE_LIMIT_WS_CONNECTIONS_PER_IP=20
