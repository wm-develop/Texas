# Game server
PORT=8080

# memory keeps all runtime state in process. postgres persists accounts,
# sessions, wallets, rooms and chip transactions.
STORAGE_BACKEND=memory
DATABASE_URL=
# Keep false in production and run cmd/migrate before starting the server.
DATABASE_AUTO_MIGRATE=false
# Comma-separated exact Web origins used by deployed Flutter Web clients.
ALLOWED_ORIGINS=
# Short-lived access tokens are rotated by the client with the refresh token.
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000

# Tencent Cloud TRTC
# Copy this file to .env locally. Never commit the real secret key.
TRTC_SDK_APP_ID=
TRTC_SECRET_KEY=
TRTC_USER_SIG_EXPIRE_SECONDS=3600

# Required when requesting debug credentials from another device.
TRTC_DEBUG_TOKEN=
