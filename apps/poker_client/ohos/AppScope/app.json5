{
  "app": {
    "bundleName": "com.texas.game.poker_client",
    "vendor": "example",
    // HarmonyOS 不读取 pubspec.yaml，版本必须在此手动同步。
    // versionName 与 pubspec.yaml 的版本号保持一致。
    // versionCode 按 major*1000000 + minor*1000 + patch 编码，
    // 与 versionName 一一对应（0.2.0 -> 2000），且随版本单调递增。
    "versionCode": 2000,
    "versionName": "0.2.0",
    "icon": "$media:app_icon",
    "label": "$string:app_name"
  }
}
