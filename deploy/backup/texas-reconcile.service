[Unit]
Description=好友德州账本对账
Documentation=https://github.com/wm-develop/Texas/blob/main/docs/BACKUP_AND_RESTORE_GUIDE.md
After=docker.service
Requires=docker.service
# 对账失败或脚本异常时触发告警单元，%n 展开为本单元名
OnFailure=texas-alert@%n.service

[Service]
Type=oneshot
ExecStart=/opt/texas/bin/texas-reconcile.sh /opt/texas/backup.env
TimeoutStartSec=600
Nice=10
